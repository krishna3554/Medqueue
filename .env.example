# Backend endpoint used by the Vite client.
VITE_API_URL=http://localhost:8000

# Backend deployment settings (do not use the development default secret outside local work).
MEDQUEUE_DATABASE_URL=sqlite:///./medqueue.db
# PostgreSQL option (with `docker compose --profile postgres up`):
# MEDQUEUE_DATABASE_URL=postgresql://medqueue:medqueue@db:5432/medqueue
MEDQUEUE_JWT_SECRET=replace-with-a-strong-secret
MEDQUEUE_CORS_ORIGINS=http://localhost:5173
# Optional overrides (defaults resolve inside the repo / container).
# MEDQUEUE_RULES_PATH=/docs/red_flag_rules.yaml
# MEDQUEUE_MODEL_DIR=/ml/artifacts
